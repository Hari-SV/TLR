rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Common helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }


    // ============================================================
    // GameSession validation
    //
    // Frozen remote contract:
    // exactly 7 fields
    // ============================================================

    function isValidGameSession(data) {
      let allowedFields = [
        'schemaVersion',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'completed',
        'terminationReason',
        'clientVersion'
      ];

      return data.keys().hasAll(allowedFields)
        && data.keys().hasOnly(allowedFields)

        && data.schemaVersion is int
        && data.schemaVersion == 2

        && data.startedAt is timestamp
        && data.endedAt is timestamp
        && data.endedAt >= data.startedAt

        && data.durationSeconds is number
        && data.durationSeconds >= 0

        && data.completed is bool

        && data.terminationReason is string
        && (
          (
            data.completed == true
            && data.terminationReason == 'victory'
          )
          ||
          (
            data.completed == false
            && (
              data.terminationReason == 'abandoned'
              || data.terminationReason == 'save_and_quit'
            )
          )
        )

        && data.clientVersion is string;
    }


    // ============================================================
    // SaveGame v2 validation
    // ============================================================

    function isValidSavePlayer(data) {
      let allowedFields = [
        'position',
        'yaw',
        'pitch'
      ];

      let allowedPositionFields = [
        'x',
        'y',
        'z'
      ];

      return data is map

        && data.keys().hasAll(allowedFields)
        && data.keys().hasOnly(allowedFields)

        && data.position is map
        && data.position.keys().hasAll(allowedPositionFields)
        && data.position.keys().hasOnly(allowedPositionFields)

        && data.position.x is number
        && data.position.y is number
        && data.position.z is number

        && data.yaw is number
        && data.yaw >= 0
        && data.yaw < 360

        && data.pitch is number
        && data.pitch >= -90
        && data.pitch <= 90;
    }


    function isValidTutorialSave(data) {
      let allowedFields = [
        'stage',
        'practiceSpreadCount',
        'litTorchIds'
      ];

      let allowedStages = [
        'Stage0_Start',
        'Stage1_FireRunePickup',
        'Stage2_FirstTorchLit',
        'Stage3_PracticeFireWindSpread',
        'Stage4_MonumentPuzzle',
        'Stage5_Completed'
      ];

      let allowedTorchIds = [
        'tutorial-path-torch-01',
        'tutorial-path-torch-02',
        'tutorial-path-torch-03',
        'tutorial-path-torch-04',
        'tutorial-path-torch-05',
        'tutorial-path-torch-06',
        'tutorial-path-torch-07',
        'tutorial-path-torch-08',
        'tutorial-path-torch-09',
        'tutorial-path-torch-10'
      ];

      return data is map

        && data.keys().hasAll(allowedFields)
        && data.keys().hasOnly(allowedFields)

        && data.stage is string
        && data.stage in allowedStages

        && data.practiceSpreadCount is int
        && data.practiceSpreadCount >= 0
        && data.practiceSpreadCount <= 100

        && data.litTorchIds is list
        && data.litTorchIds.size() <= 10

        // Every entry must be one of the 10 stable path-torch IDs.
        && data.litTorchIds.hasOnly(allowedTorchIds)

        // No duplicate IDs.
        && data.litTorchIds.toSet().size()
            == data.litTorchIds.size();
    }


    function isValidCaveSave(data) {
      let allowedFields = [
        'unlockedSpells',
        'openedEntranceIds',
        'completedPuzzleIds',
        'openingCinematicSeen'
      ];

      let allowedSpells = [
        'Fire',
        'Wind',
        'Earth',
        'Water'
      ];

      let allowedEntranceIds = [
        'earth-rune-entrance',
        'weight-puzzle-entrance'
      ];

      let allowedPuzzleIds = [
        'random-socket-scale-prefab'
      ];

      return data is map

        && data.keys().hasAll(allowedFields)
        && data.keys().hasOnly(allowedFields)

        // --------------------------
        // Spells
        // --------------------------

        && data.unlockedSpells is list
        && data.unlockedSpells.size() <= 4
        && data.unlockedSpells.hasOnly(allowedSpells)
        && data.unlockedSpells.toSet().size()
            == data.unlockedSpells.size()

        // --------------------------
        // Opened entrances
        // --------------------------

        && data.openedEntranceIds is list
        && data.openedEntranceIds.size() <= 2
        && data.openedEntranceIds.hasOnly(allowedEntranceIds)
        && data.openedEntranceIds.toSet().size()
            == data.openedEntranceIds.size()

        // --------------------------
        // Completed puzzles
        // --------------------------

        && data.completedPuzzleIds is list
        && data.completedPuzzleIds.size() <= 1
        && data.completedPuzzleIds.hasOnly(allowedPuzzleIds)
        && data.completedPuzzleIds.toSet().size()
            == data.completedPuzzleIds.size()

        // --------------------------
        // Opening state
        // --------------------------

        && data.openingCinematicSeen is bool;
    }


    function isValidSaveGame(data) {
      let requiredFields = [
        'schemaVersion',
        'clientVersion',
        'savedAtUtc',
        'scene',
        'runElapsedSecondsBeforeSave'
      ];

      let optionalFields = [
        'player',
        'tutorial',
        'cave'
      ];

      return data.keys().hasAll(requiredFields)

        && data.keys().hasOnly(
          requiredFields.concat(optionalFields)
        )

        // --------------------------
        // Base SaveGame fields
        // --------------------------

        && data.schemaVersion is int
        && data.schemaVersion == 2

        && data.clientVersion is string

        && data.savedAtUtc is timestamp

        && data.scene is string
        && data.scene in [
          'New Tutorial Scene',
          'Cave'
        ]

        && data.runElapsedSecondsBeforeSave is number
        && data.runElapsedSecondsBeforeSave >= 0

        // --------------------------
        // Optional player map
        // --------------------------

        && (
          !('player' in data)
          || isValidSavePlayer(data.player)
        )

        // --------------------------
        // Optional Tutorial map
        // --------------------------

        && (
          !('tutorial' in data)
          || isValidTutorialSave(data.tutorial)
        )

        // --------------------------
        // Optional Cave map
        // --------------------------

        && (
          !('cave' in data)
          || isValidCaveSave(data.cave)
        )

        // --------------------------
        // Scene exclusivity
        //
        // Tutorial save may not carry Cave state.
        // Cave save may not carry Tutorial state.
        // Optional maps remain optional for legacy/migrated
        // SaveGame states.
        // --------------------------

        && (
          data.scene != 'New Tutorial Scene'
          || !('cave' in data)
        )

        && (
          data.scene != 'Cave'
          || !('tutorial' in data)
        );
    }


    // ============================================================
    // Report validation (website)
    // ============================================================

    function isValidReport(data) {
      return data.keys().hasAll([
          'type',
          'message',
          'createdAt'
        ])
        && data.message is string
        && data.message.size() > 0
        && data.message.size() < 5000;
    }


    // ============================================================
    // Username index
    // ============================================================

    match /usernames/{username} {

      // Preserves current username lookup behaviour.
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }


    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {

      // WEBSITE: owner reads their own profile; admins can read ANY
      // profile and list the whole collection (admin user directory +
      // admin profile view).
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'username',
          'email',
          'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp;

      // WEBSITE: owner may update their doc (username stays valid if
      // present), but an owner can NEVER touch their own `suspended`
      // field -- that would let a suspended user un-suspend themselves.
      // Admins may update ONLY the `suspended` field, nothing else.
      allow update: if (
          isOwner(userId)
          && (
            !('username' in request.resource.data)
            ||
            (
              request.resource.data.username is string
              && request.resource.data.username.size() > 0
            )
          )
          && !('suspended' in request.resource.data.diff(resource.data).affectedKeys())
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
          && request.resource.data.suspended is bool
        );

      allow delete: if false;


      // ==========================================================
      // Game Sessions
      //
      // users/{uid}/gameSessions/{sessionId}
      // ==========================================================

      match /gameSessions/{sessionId} {

        // WEBSITE: admins can view a user's sessions too (admin profile
        // view), on top of the existing owner access.
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && sessionId.matches('^[0-9a-f]{32}$')
          && isValidGameSession(request.resource.data);

        // Existing design keeps a GameSession immutable
        // after creation.
        allow update: if isOwner(userId)
          && sessionId.matches('^[0-9a-f]{32}$')
          && isValidGameSession(request.resource.data)
          && request.resource.data == resource.data;

        allow delete: if false;
      }


      // ==========================================================
      // Achievements
      //
      // Frozen remote contract:
      // exactly 4 fields
      // ==========================================================

      match /achievements/{achievementId} {

        // WEBSITE: admins can view a user's achievements too (admin
        // profile view), on top of the existing owner access.
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)

          && achievementId in [
            'tutorial_complete',
            'speedrun_bronze',
            'speedrun_silver',
            'speedrun_gold'
          ]

          && request.resource.data.keys().hasOnly([
            'schemaVersion',
            'unlockedAt',
            'metricValueSeconds',
            'clientVersion'
          ])

          && request.resource.data.keys().hasAll([
            'schemaVersion',
            'unlockedAt',
            'metricValueSeconds',
            'clientVersion'
          ])

          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion == 1

          && request.resource.data.unlockedAt is timestamp

          && request.resource.data.metricValueSeconds is number
          && request.resource.data.metricValueSeconds >= 0

          && request.resource.data.clientVersion is string
          && request.resource.data.clientVersion.size() <= 64;

        allow update: if false;
        allow delete: if false;
      }


      // ==========================================================
      // SaveGame
      //
      // Canonical Phase C slot:
      //
      // users/{uid}/saveGames/current
      //
      // Only the authenticated owner may access it. Not touched by
      // any website feature -- left exactly as your team wrote it.
      // ==========================================================

      match /saveGames/{saveId} {

        // Phase C uses a direct GET on the canonical slot.
        allow get: if isOwner(userId)
          && saveId == 'current';

        // There is no reason for the game client to enumerate
        // SaveGame documents in the one-slot design.
        allow list: if false;

        allow create: if isOwner(userId)
          && saveId == 'current'
          && isValidSaveGame(request.resource.data);

        allow update: if isOwner(userId)
          && saveId == 'current'
          && isValidSaveGame(request.resource.data);

        allow delete: if false;
      }
    }


    // ============================================================
    // Collection-group GameSession queries
    //
    // Public `list` -- reopened after the team's earlier tightening to
    // admin-only. Decision: no sensitive data lives in gameSessions, so
    // broad read access here isn't a security concern. This powers the
    // public leaderboard directly (stats.js runs a collectionGroup
    // query filtered to completed==true, aggregated client-side).
    // ============================================================

    match /{path=**}/gameSessions/{sessionId} {
      allow list: if true;
    }


    // ============================================================
    // Admin records
    // ============================================================

    match /admins/{uid} {

      allow read: if isOwner(uid);

      // Admin membership is not self-assignable.
      allow write: if false;
    }


    // ============================================================
    // Reports (website)
    // ============================================================

    match /reports/{reportId} {

      // WEBSITE: reports require a signed-in user, and the stored `uid`
      // must match the submitter (so nobody can file a report as
      // someone else).
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReport(request.resource.data);

      allow read, update, delete: if isAdmin();
    }
  }
}
