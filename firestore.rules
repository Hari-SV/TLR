rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Shared helper functions
    // ============================================
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }
    function isValidGameSession(data) {
      let allowedFields = [
        'schemaVersion',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'completed',
        'terminationReason',
        'clientVersion'
      ];
      return data.keys().hasAll(allowedFields)
        && data.keys().hasOnly(allowedFields)
        && data.schemaVersion is int
        && data.schemaVersion == 2
        && data.startedAt is timestamp
        && data.endedAt is timestamp
        && data.endedAt >= data.startedAt
        && data.durationSeconds is number
        && data.durationSeconds >= 0
        && data.completed is bool
        && data.terminationReason is string
        && (
          (
            data.completed == true
            && data.terminationReason == 'victory'
          )
          ||
          (
            data.completed == false
            && data.terminationReason == 'abandoned'
          )
        )
        && data.clientVersion is string;
    }
    // Website-only: is this uid on the admin allowlist?
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Website-only: does a bug/feedback report have the right shape?
    function isValidReport(data) {
      return data.keys().hasAll(['type', 'message', 'createdAt'])
        && data.message is string
        && data.message.size() > 0
        && data.message.size() < 5000;
    }

    // ============================================
    // usernames/{username}
    // CHANGED for the leaderboard: `list` widened from `false` to `true`.
    // Individual username docs were already fully public via `get` (anyone
    // can look up any single username by ID) -- this just permits
    // *querying* that already-public collection, e.g. "give me the
    // usernames for these 10 uids", which the leaderboard needs to turn
    // uids into display names.
    // ============================================
    match /usernames/{username} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ============================================
    // users/{userId}  (+ game subcollections)
    // CONFLICT: your rules let an owner write ANY fields to their own
    // /users/{userId} doc (no validation). The website's signup flow
    // writes exactly `username`, `email`, `createdAt` and needs those
    // three to be well-formed. Rather than silently locking the doc down
    // to ONLY those three fields (which could break a Unity write you
    // haven't told me about), this requires those three fields to be
    // present and correctly typed on create, but does NOT forbid
    // additional fields. This is a judgment call, not a certainty --
    // please confirm with your teammates whether Unity writes anything
    // else to this top-level document. If it doesn't, you can safely
    // tighten this to `.hasOnly([...])` for stricter validation.
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'email', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp;

      // Owner may update their doc; if a `username` field is present in
      // the update it must stay a valid non-empty string (mirrors the
      // create check without re-demanding email/createdAt be re-sent).
      allow update: if isOwner(userId)
        && (!('username' in request.resource.data)
            || (request.resource.data.username is string
                && request.resource.data.username.size() > 0));

      allow delete: if false;

      match /gameSessions/{sessionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && sessionId.matches('^[0-9a-f]{32}$')
          && isValidGameSession(request.resource.data);
        allow update: if isOwner(userId)
          && sessionId.matches('^[0-9a-f]{32}$')
          && isValidGameSession(request.resource.data)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      match /achievements/{achievementId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && achievementId in [
               'tutorial_complete',
               'speedrun_bronze',
               'speedrun_silver',
               'speedrun_gold'
             ]
          && request.resource.data.keys().hasOnly([
               'schemaVersion',
               'unlockedAt',
               'metricValueSeconds',
               'clientVersion'
             ])
          && request.resource.data.keys().hasAll([
               'schemaVersion',
               'unlockedAt',
               'metricValueSeconds',
               'clientVersion'
             ])
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion == 1
          && request.resource.data.unlockedAt is timestamp
          && request.resource.data.metricValueSeconds is number
          && request.resource.data.metricValueSeconds >= 0
          && request.resource.data.clientVersion is string
          && request.resource.data.clientVersion.size() <= 64;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ============================================
    // Collection-group rule for gameSessions -- REQUIRED for the leaderboard.
    // A rule nested under /users/{userId}/gameSessions only authorizes
    // listing ONE known user's subcollection. A collection-group query
    // (db.collectionGroup('gameSessions'), which reads across every
    // user's sessions at once) is a different operation and needs this
    // separate top-level rule using the {path=**} wildcard. This does not
    // replace or weaken the owner-only get/create/update/delete rules
    // above -- Firestore evaluates all matching rules for a given
    // operation and grants access if ANY of them allow it, so this rule
    // adds public `list` on top of everything else, without touching it.
    //
    // TRADE-OFF: this exposes the FULL contents of every completed
    // session (startedAt, endedAt, terminationReason, clientVersion --
    // not just durationSeconds) to anyone who runs this query, since
    // Firestore can't restrict which fields a list query returns. If
    // that's a concern, the fix is a denormalized leaderboard collection
    // or a Cloud Function instead -- say the word and I'll build that
    // version.
    // ============================================
    match /{path=**}/gameSessions/{sessionId} {
      allow list: if true;
    }

    // ============================================
    // admins/{uid}  -- website-only, net new, no conflict
    // Doc ID = admin's UID. No client can write this collection; admins
    // are added manually from the Firebase console (see README).
    // ============================================
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ============================================
    // reports/{reportId}  -- website-only, net new, no conflict
    // Anyone (even signed out) can file a bug report or feedback.
    // Only admins can read, edit, or delete the list.
    // ============================================
    match /reports/{reportId} {
      allow create: if isValidReport(request.resource.data);
      allow read, update, delete: if isAdmin();
    }
  }
}
